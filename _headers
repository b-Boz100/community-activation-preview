# Cloudflare Pages headers (brief section 10).
# CSP is built from what HubSpot, YouTube (nocookie), self-hosted fonts and GA4 load.
# Re-check against the browser network panel once real HubSpot and GA4 IDs are set,
# then prove the form still submits with this policy on.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://*.hsforms.net https://*.hsforms.com https://*.hubspot.com https://*.hs-scripts.com https://*.hs-analytics.net https://*.hs-banner.com https://*.hscollectedforms.net https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://*.hsforms.net https://*.hsforms.com; img-src 'self' data: https://i.ytimg.com https://*.hsforms.com https://*.hsforms.net https://*.hubspot.com https://*.hubspotusercontent-na1.net https://*.hubspotusercontent-ap1.net https://www.googletagmanager.com https://*.google-analytics.com; font-src 'self' https://*.hsforms.net; frame-src https://www.youtube-nocookie.com https://*.hsforms.net https://*.hsforms.com https://share.hsforms.com https://share-ap1.hsforms.com https://*.hubspot.com; connect-src 'self' https://*.hsforms.net https://*.hsforms.com https://*.hubspot.com https://*.hubapi.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; form-action 'self' https://*.hsforms.com https://*.hubspot.com; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=(), fullscreen=(self "https://www.youtube-nocookie.com"), autoplay=(self "https://www.youtube-nocookie.com"), encrypted-media=(self "https://www.youtube-nocookie.com"), picture-in-picture=(self "https://www.youtube-nocookie.com")

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
